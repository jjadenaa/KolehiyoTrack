{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present && rm -rf dist && cp -r artifacts/upcat/dist/public dist",
    "start": "node artifacts/upcat/dist/server.js",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace=@workspace/upcat"
  },
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pdf-parse": "^1.1.5",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "katex": "^0.18.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108"
  }
}
