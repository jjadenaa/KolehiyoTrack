{
  "buildCommand": "npm run build --workspace=@workspace/upcat",
  "outputDirectory": "artifacts/upcat/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/artifacts/upcat/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
